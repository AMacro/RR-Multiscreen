<Project>
    <PropertyGroup>
        <!-- Your Railroader install folder (the one holding Railroader_Data). Examples:
             Windows: C:\Program Files (x86)\Steam\steamapps\common\Railroader
             Linux:   /home/you/.local/share/Steam/steamapps/common/Railroader -->
        <InstallDir>C:\Program Files (x86)\Steam\steamapps\common\Railroader</InstallDir>
        <!-- Optional code signing for Release builds on Windows; leave Cert-Thumb empty to skip. -->
        <SignToolPath>C:\Program Files (x86)\Microsoft SDKs\ClickOnce\SignTool\</SignToolPath>
        <Cert-Thumb></Cert-Thumb>
    </PropertyGroup>
</Project>
